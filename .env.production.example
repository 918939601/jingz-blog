# Public site URL used by next-sitemap and deployment metadata
SITE_URL=https://blog.example.com

# Admin whitelist, comma-separated
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# NextAuth
AUTH_SECRET=replace-me
AUTH_GITHUB_ID=replace-me
AUTH_GITHUB_SECRET=replace-me

# Public / server Go API base URL when Nginx proxies /goapi to the Go service
NEXT_PUBLIC_GO_API_BASE=https://blog.example.com/goapi
GO_API_BASE=https://blog.example.com/goapi

# Shared with the Go service for /api/revalidate
REVALIDATE_SECRET=replace-me

# UploadThing
UPLOADTHING_TOKEN=replace-me

# Prisma / PostgreSQL
DATABASE_URL=postgres://username:password@db-host:5432/blog?sslmode=require
